# ---------- โหมดการส่ง: graph (แนะนำ) หรือ smtp ----------
MAIL_MODE=graph

# ---------- อีเมลผู้ส่ง (บัญชี O365) ----------
O365_SENDER=sender@yourcompany.com

# ---------- Microsoft Graph API (ต้องลงทะเบียนแอปใน Azure AD ก่อน) ----------
O365_TENANT_ID=your-tenant-id
O365_CLIENT_ID=your-client-id
O365_CLIENT_SECRET=your-client-secret

# ---------- SMTP (สำรอง — ใช้เมื่อ MAIL_MODE=smtp) ----------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=sender@yourcompany.com
SMTP_PASSWORD=your-password-or-app-password
