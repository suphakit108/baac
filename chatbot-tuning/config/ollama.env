# เพิ่มใน environment ของ container openwebui-ollama แล้ว recreate เฉพาะ ollama
# ตรวจหลังตั้ง: docker exec openwebui-ollama ollama ps  -> ต้องเห็น qwen-baac และ bge-m3 ค้างอยู่ทั้งคู่ (UNTIL = Forever)

# ค้างโมเดลไว้ในหน่วยความจำตลอด ไม่ต้องโหลดใหม่ทุกคำถาม (โหลดใหม่ครั้งละหลายวินาที)
OLLAMA_KEEP_ALIVE=-1

# qwen (ตอบ) + bge-m3 (embedding) ต้องอยู่พร้อมกัน ไม่งั้นจะสลับโหลดทุกคำถาม
# ถ้าใช้ gemma-2b-fast เป็น Task Model ให้เปลี่ยนเป็น 3 และตรวจว่า RAM/VRAM พอ
OLLAMA_MAX_LOADED_MODELS=2

# จำนวนคำขอพร้อมกันต่อโมเดล 2 = รับผู้ใช้ 2 คนพร้อมกันได้โดยไม่ต่อคิว
# แต่แต่ละช่องใช้ KV cache แยก (กินหน่วยความจำเพิ่ม)
OLLAMA_NUM_PARALLEL=2

# เฉพาะเครื่องที่มี GPU: เร่ง prompt eval และลดหน่วยความจำ KV cache ครึ่งหนึ่ง
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
